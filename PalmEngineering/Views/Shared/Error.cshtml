@model PalmEngineering.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 style="color: #dc3545;">Error</h1>
<h2>An error occurred while processing your request.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Please try again or contact us if the problem persists.</h3>
<a href="/" class="btn-primary" style="display: inline-block; margin-top: 1rem;">Return to Home</a>