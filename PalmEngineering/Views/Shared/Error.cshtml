@model PalmEngineering.Models.ErrorViewModel
@{
    ViewData["Title"] = Model.StatusCode == 404 ? "Page not found" : "Something went wrong";
}

<div class="container">
<div class="error-page">
    @if (Model.StatusCode == 404)
    {
        <h1>Page not found</h1>
        <p>We could not find the page you were looking for. It may have moved or the link may be wrong.</p>
    }
    else if (Model.StatusCode == 429)
    {
        <h1>Too many requests</h1>
        <p>Please wait a moment and try again.</p>
    }
    else
    {
        <h1>Something went wrong</h1>
        <p>An error occurred while processing your request. Please try again or contact us if the problem persists.</p>
    }

    @if (Model.ShowRequestId)
    {
        <p><strong>Reference:</strong> <code>@Model.RequestId</code></p>
    }

    <a href="/" class="btn-primary">Return to Home</a>
</div>
</div>
