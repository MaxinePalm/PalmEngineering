@{
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var nav = new[]
    {
        new { Label = "Home", Href = "/", Action = "Index" },
        new { Label = "About", Href = "/Home/About", Action = "About" },
        new { Label = "Services", Href = "/Home/Services", Action = "Services" },
        new { Label = "Gallery", Href = "/Home/Gallery", Action = "Gallery" },
        new { Label = "Contact", Href = "/Home/Contact", Action = "Contact" }
    };
    var pages = new[]
    {
        new { Label = "Home", Href = "/", Keys = "g h", Kw = "home start" },
        new { Label = "About", Href = "/Home/About", Keys = "g a", Kw = "about company" },
        new { Label = "Services", Href = "/Home/Services", Keys = "g s", Kw = "services milling turning" },
        new { Label = "Gallery", Href = "/Home/Gallery", Keys = "g g", Kw = "gallery photos projects" },
        new { Label = "Contact", Href = "/Home/Contact", Keys = "g c", Kw = "contact phone email address hours" },
        new { Label = "Privacy Policy", Href = "/privacy", Keys = "", Kw = "privacy popia data" },
        new { Label = "Terms of Use", Href = "/terms", Keys = "", Kw = "terms conditions legal" }
    };
    var description = ViewData["Description"] as string
        ?? "Palm Engineering is a precision CNC machining and general engineering workshop in Sidwell, Gqeberha, with over 30 years of experience.";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="@description" />
    <meta name="theme-color" content="#0f2557" />
    <title>@ViewData["Title"] - Palm Engineering</title>
    <link rel="preload" href="~/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script type="speculationrules">
    {"prerender":[{"where":{"href_matches":"/*"},"eagerness":"moderate"}]}
    </script>
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header>
        <div class="header-content">
            <a href="/" class="logo" aria-label="Palm Engineering home">
                <span class="logo-icon" aria-hidden="true">⚙️</span>
                <span>Palm Engineering</span>
            </a>
            <div class="header-right">
                <nav aria-label="Main">
                    <ul>
                        @foreach (var n in nav)
                        {
                            <li><a class="hit-slop" href="@n.Href" aria-current="@(n.Action == action ? "page" : null)">@n.Label</a></li>
                        }
                    </ul>
                </nav>
                <button type="button" id="cmd-open" class="cmd-trigger hit-slop" aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K">
                    <span>Search</span>
                    <kbd class="kbd-hint" aria-hidden="true"><span data-mod>Ctrl</span> K</kbd>
                </button>
            </div>
        </div>
    </header>

    <main id="main" tabindex="-1">
        @RenderBody()
    </main>

    <footer>
        <p style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem;">&copy; @DateTime.Now.Year @Biz.LegalName t/a @Biz.TradingName</p>
        <p class="reg-line">
            Reg. No @Biz.RegistrationNumber
            @if (!string.IsNullOrWhiteSpace(Biz.VatNumber))
            {
                <text>| VAT No @Biz.VatNumber</text>
            }
        </p>
        <p>Precision CNC Machining | Quality Engineering Solutions</p>
        <p style="font-size: 0.9rem; margin-top: 1rem;">@Biz.StreetAddress, @Biz.Suburb, @Biz.City, @Biz.PostalCode</p>
        <nav class="footer-links" aria-label="Legal">
            <a class="hit-slop" href="/privacy">Privacy Policy</a>
            <a class="hit-slop" href="/terms">Terms of Use</a>
        </nav>
    </footer>

    <dialog id="cmd" class="sheet cmd" aria-label="Command menu">
        <div class="sheet-body">
            <div class="sheet-grip" data-drag aria-hidden="true"></div>
            <div class="cmd-row">
                <input id="cmd-input" type="text" role="combobox" aria-expanded="true" aria-controls="cmd-list" aria-autocomplete="list" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Search pages and actions" aria-label="Search pages and actions" />
                <kbd class="kbd-hint" aria-hidden="true">Esc</kbd>
            </div>
            <ul id="cmd-list" class="cmd-list" role="listbox" aria-label="Pages and actions">
                <li class="cmd-group" role="presentation">Pages</li>
                @foreach (var p in pages)
                {
                    <li role="option" aria-selected="false" data-href="@p.Href" data-keys="@p.Keys" data-kw="@p.Kw">
                        <span>@p.Label</span>
                        @if (p.Keys.Length > 0)
                        {
                            <span class="keys" aria-hidden="true">
                                @foreach (var k in p.Keys.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <kbd>@k.ToUpperInvariant()</kbd>
                                }
                            </span>
                        }
                    </li>
                }
                <li class="cmd-group" role="presentation">Actions</li>
                <li role="option" aria-selected="false" data-href="tel:@BusinessInfo.Tel(Biz.PreferredPhone)" data-kw="call phone ring"><span>Call @Biz.PreferredPhone</span></li>
                <li role="option" aria-selected="false" data-href="mailto:@Biz.Email" data-kw="email write message"><span>Email @Biz.Email</span></li>
                <li role="option" aria-selected="false" data-copy="@Biz.Email" data-label="Email address" data-kw="copy email"><span>Copy email address</span></li>
                <li role="option" aria-selected="false" data-copy="@Biz.FullAddress" data-label="Address" data-kw="copy address location"><span>Copy address</span></li>
                <li role="option" aria-selected="false" data-action="clear-shortlist" data-kw="clear shortlist saved gallery"><span>Clear gallery shortlist</span></li>
                <li class="cmd-group" role="presentation">Gallery</li>
                @foreach (var g in GalleryCatalog.Items)
                {
                    <li role="option" aria-selected="false" data-href="/Home/Gallery#@g.Slug" data-kw="gallery @g.Title.ToLowerInvariant()"><span>@g.Title</span></li>
                }
            </ul>
            <p id="cmd-empty" class="cmd-empty" hidden>No matches found.</p>
        </div>
    </dialog>

    <div id="toasts" class="toasts" role="status" aria-live="polite"></div>

    <script src="~/js/blurhash.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
