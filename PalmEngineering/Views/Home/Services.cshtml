@model List<PalmEngineering.Models.Service>
@{
    ViewData["Title"] = "Our Services";
    ViewData["Description"] = "CNC milling, CNC turning, grinding, wire EDM, inspection and prototyping from Palm Engineering in Gqeberha.";
}

<h1 class="page-title">Our Services</h1>

<p class="page-lead">
    Precision machining solutions for your projects
</p>

<div class="divider divider-left divider-wide"></div>

<div class="services-grid">
    @foreach (var service in Model)
    {
        <div class="service-card">
            <div class="service-icon" aria-hidden="true">@service.Icon</div>
            <h2>@service.Name</h2>
            <p>@service.Description</p>
        </div>
    }
</div>

<section class="materials" aria-labelledby="materials-heading">

    <h2 id="materials-heading">
        Materials We Work With
    </h2>

    <div class="divider divider-left"></div>

    <div class="materials-grid">

        <div>
            <h3>Metals</h3>
            <ul class="capabilities">
                <li>Aluminium (6061, 7075, MIC-6)</li>
                <li>Steel (4140, 4340, A36)</li>
                <li>Stainless Steel (304, 316, 17-4 PH)</li>
                <li>Titanium (Grade 5, Grade 2)</li>
                <li>Brass &amp; Copper</li>
            </ul>
        </div>

        <div>
            <h3>Plastics</h3>
            <ul class="capabilities">
                <li>Delrin (Acetal)</li>
                <li>PEEK</li>
                <li>Nylon</li>
                <li>UHMW</li>
                <li>Acrylic</li>
            </ul>
        </div>

    </div>
</section>
