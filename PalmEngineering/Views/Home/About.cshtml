@{
    ViewData["Title"] = "About Us";
    ViewData["Description"] = "About Palm Engineering: over 30 years of general and precision engineering, tooling and innovative design in Gqeberha.";
}

<h1 class="page-title" style="margin-bottom: 3rem;">About Palm Engineering</h1>

<div class="about-content">

    <div>
        <h2>Your Partner in Precision Manufacturing</h2>
        <div class="divider divider-left"></div>

        <p>
            With over 30 years of experience in general and precision engineering, tooling and innovative design,
            we produce custom components and equipment for industrial, automotive, brewing, woodworking and educational customers.
        </p>
        <p>
            Our Gqeberha workshop combines CNC machining with skilled hands-on engineering, so we can take a job from
            first sketch or drawing through to a finished, checked part.
        </p>

        <h2 style="margin-top: 3rem;">Our Capabilities</h2>
        <div class="divider divider-left"></div>

        <ul class="capabilities">
            <li>CNC milling</li>
            <li>CNC turning and lathe work</li>
            <li>Wire EDM for complex geometries</li>
            <li>Surface and cylindrical grinding</li>
            <li>Inspection and quality documentation</li>
            <li>Machining in a range of metals and engineering plastics</li>
            <li>Prototype to production runs</li>
            <li>Design and innovation support</li>
        </ul>
    </div>

    <div>
        <h2>Our Approach to Quality</h2>
        <div class="divider divider-left"></div>

        <p>We aim to supply quality products on time and at the right price:</p>

        <ul class="capabilities">
            <li>Work to your drawings and specifications</li>
            <li>Parts checked throughout manufacture</li>
            <li>Realistic lead times agreed upfront</li>
            <li>B-BBEE Rating Level 4</li>
        </ul>

        <h2 style="margin-top: 3rem;">Work We Do</h2>
        <div class="divider divider-left"></div>

        <ul class="capabilities">
            <li>Material handling and conveying</li>
            <li>Automotive components</li>
            <li>Brewing equipment</li>
            <li>Stainless steel fabrication</li>
            <li>Woodworking tools</li>
            <li>Educational projects</li>
        </ul>
    </div>
</div>
