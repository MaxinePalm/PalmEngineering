@{
    ViewData["Title"] = "About Us";
}

<h1 style="color: #1e3c72; margin-bottom: 2rem;">About Precision Engineering Solutions</h1>

<div class="about-content">
    <div class="about-text">
        <h2>Your Partner in Precision Manufacturing</h2>
        <p style="margin-bottom: 1rem;">With over 25 years of experience in precision engineering, we specialize in producing high-quality components for aerospace, medical, automotive, and industrial applications.</p>
        <p style="margin-bottom: 1rem;">Our state-of-the-art facility houses the latest CNC milling centers, turning centers, and inspection equipment, enabling us to deliver parts with exceptional accuracy and repeatability.</p>

        <h2 style="margin-top: 2rem;">Our Capabilities</h2>
        <ul class="capabilities">
            <li>5-axis CNC milling up to 40" x 20" x 24"</li>
            <li>CNC turning with live tooling</li>
            <li>Wire EDM for complex geometries</li>
            <li>Surface grinding and precision finishing</li>
            <li>CMM inspection and quality documentation</li>
            <li>Material expertise: aluminum, steel, stainless, titanium, plastics</li>
            <li>Prototype to production runs</li>
            <li>Design consultation and DFM support</li>
        </ul>
    </div>

    <div>
        <h2 style="color: #1e3c72; margin-bottom: 1rem;">Quality Standards</h2>
        <p style="margin-bottom: 1rem;">We maintain the highest quality standards in every project:</p>
        <ul class="capabilities">
            <li>ISO 9001:2015 Certified</li>
            <li>AS9100 Aerospace Certified</li>
            <li>First Article Inspection (FAI)</li>
            <li>Statistical Process Control (SPC)</li>
            <li>Full traceability and documentation</li>
        </ul>

        <h2 style="color: #1e3c72; margin-top: 2rem; margin-bottom: 1rem;">Industries Served</h2>
        <ul class="capabilities">
            <li>Aerospace & Defense</li>
            <li>Medical Devices</li>
            <li>Automotive Racing</li>
            <li>Industrial Automation</li>
            <li>Oil & Gas</li>
            <li>Robotics</li>
        </ul>
    </div>
</div>