@model List<PalmEngineering.Models.Service>

@{
    ViewData["Title"] = "Home";
    ViewData["Description"] = "Palm Engineering: precision CNC machining, turning, grinding and custom engineering in Sidwell, Gqeberha. Over 30 years of experience.";
    Layout = "_Layout";
    var values = new[]
    {
        new { Icon = "target", Name = "Service", Text = "Putting the customer's needs first, every job." },
        new { Icon = "bulb", Name = "Innovation", Text = "Finding better ways to make things work." },
        new { Icon = "gear", Name = "Precision", Text = "Getting the details right the first time." },
        new { Icon = "shield", Name = "Integrity", Text = "Doing what we say we will do." }
    };
    var reasons = new[]
    {
        new { Icon = "clock", Name = "Reliable turnaround", Text = "Realistic lead times agreed upfront and delivered on time." },
        new { Icon = "inspect", Name = "Quality checked", Text = "Parts are checked throughout the manufacturing process." },
        new { Icon = "people", Name = "Customer focused", Text = "Direct support from first enquiry through to final delivery." }
    };
}

<section class="hero">
    <div class="hero-inner">
        <div>
            <h1>Precision CNC machining and custom engineering</h1>
            <p class="lead">Quality components supplied on time and at the right price, from our workshop in Gqeberha.</p>
            <div class="btn-row">
                <a href="/Home/Contact" class="btn">Contact us</a>
                <a href="/Home/Gallery" class="btn btn-outline">View our work</a>
            </div>
        </div>

        <svg class="hero-drawing" viewBox="0 0 560 330" aria-hidden="true" focusable="false">
            <defs>
                <marker id="arw" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
                    <path d="M0 0L10 5L0 10z" fill="#f5a524" />
                </marker>
            </defs>
            <path class="center draw" pathLength="1" d="M16 170H512" />
            <path class="part draw" pathLength="1" d="M40 140H120V120H300V132H420V146H480V194H420V208H300V220H120V200H40Z" />
            <path class="part draw" pathLength="1" d="M120 120V220M300 120V220M420 132V208" style="stroke-width: 1.2;" />
            <g class="annot">
                <path class="ext" d="M120 118V86M300 118V86" />
                <path class="dim" d="M122 92H298" marker-start="url(#arw)" marker-end="url(#arw)" />
                <text x="210" y="82" text-anchor="middle">180</text>

                <path class="ext" d="M40 204V268M480 198V268" />
                <path class="dim" d="M42 262H478" marker-start="url(#arw)" marker-end="url(#arw)" />
                <text x="260" y="286" text-anchor="middle">440</text>

                <path class="ext" d="M302 120H520M302 220H520" />
                <path class="dim" d="M512 122V218" marker-start="url(#arw)" marker-end="url(#arw)" />
                <text x="528" y="176" transform="rotate(90 528 176)" text-anchor="middle">&#216;100</text>
            </g>
        </svg>
    </div>
</section>

<div class="title-block-wrap">
    <dl class="title-block">
        <div><dt>Registered company</dt><dd>@Biz.LegalName</dd></div>
        <div><dt>Registration no.</dt><dd class="tb-mono">@Biz.RegistrationNumber</dd></div>
        <div><dt>Workshop</dt><dd>@Biz.Suburb, @Biz.City</dd></div>
        <div><dt>Experience</dt><dd>30+ years</dd></div>
        <div><dt>B-BBEE rating</dt><dd>Level 4</dd></div>
    </dl>
</div>

<section class="band">
    <div class="inner">
        <blockquote class="mission">
            <p>Quality products supplied on time at the right price to satisfied customers who keep coming back.</p>
            <cite>Our mission</cite>
        </blockquote>
    </div>
</section>

<section class="band band-paper" aria-labelledby="services-h">
    <div class="inner">
        <div class="section-head">
            <h2 id="services-h">What we make and how</h2>
            <p>General and precision engineering, tooling and innovative design for 30 years.</p>
        </div>
        <div class="services-grid">
            @if (Model != null && Model.Any())
            {
                foreach (var service in Model)
                {
                    <div class="service-card">
                        <span class="service-icon">@Icons.Svg(service.IconClass)</span>
                        <h3>@service.Name</h3>
                        <p>@service.Description</p>
                    </div>
                }
            }
        </div>
        <p style="margin-top: 2rem;"><a class="btn-quiet" href="/Home/Services">All services and materials</a></p>
    </div>
</section>

<section class="band" aria-labelledby="values-h">
    <div class="inner">
        <div class="section-head">
            <h2 id="values-h">Our core values</h2>
        </div>
        <div class="value-grid">
            @foreach (var v in values)
            {
                <div class="value">
                    @Icons.Svg(v.Icon)
                    <h3>@v.Name</h3>
                    <p>@v.Text</p>
                </div>
            }
        </div>
    </div>
</section>

<section class="band band-paper" aria-labelledby="why-h">
    <div class="inner">
        <div class="section-head">
            <h2 id="why-h">Why choose Palm Engineering</h2>
        </div>
        <div class="value-grid">
            @foreach (var r in reasons)
            {
                <div class="value">
                    @Icons.Svg(r.Icon)
                    <h3>@r.Name</h3>
                    <p>@r.Text</p>
                </div>
            }
        </div>
    </div>
</section>

<section class="cta-band">
    <div class="cta-inner">
        <div>
            <h2>Have a part to make?</h2>
            <p>Send us your drawing, sample or idea and we will get back to you.</p>
        </div>
        <div class="btn-row">
            <a class="btn" href="/Home/Contact">Contact us</a>
            <a class="btn btn-outline tnum" href="tel:@BusinessInfo.Tel(Biz.PreferredPhone)">Call @Biz.PreferredPhone</a>
        </div>
    </div>
</section>
